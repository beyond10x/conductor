{
  "name": "conductor-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "The conductor dashboard: a Vue app the conductor binary embeds and serves beside /data.json.",
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "ux:gates": "node -e \"require('node:fs').rmSync('ux/.out',{recursive:true,force:true})\" && playwright test",
    "ux:ratchet": "node ux/ratchet.ts",
    "ux:round": "node -e \"require('node:fs').rmSync('ux/.out',{recursive:true,force:true})\" && UX_ROUND=1 playwright test; node ux/round.ts"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
