{
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "deny": [
      "Artifact",
      "Workflow",
      "ScheduleWakeup",
      "EnterWorktree",
      "AskUserQuestion",
      "ReportFindings",
      "ShareOnboardingGuide"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "conductor guard record-guard-decision --from-pre-tool-use --pid \"$PPID\" || exit 2"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "conductor session claim --from-session-start --pid \"$PPID\" || exit 2"
          }
        ]
      }
    ]
  },
  "disableAllHooks": false
}
