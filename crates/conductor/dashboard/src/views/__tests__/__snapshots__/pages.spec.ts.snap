                    <td data-v-262fdc11="">smaller /var/tmp entries</td>
                    <td data-v-262fdc11="" class="mono small">/var/tmp</td>
                    <td data-v-262fdc11="" class="num">2</td>
                    <td data-v-262fdc11="">agent</td>
                    <td data-v-262fdc11="">2d 4h</td>
                    <td data-v-262fdc11="">measured</td>
                    <td data-v-262fdc11="" class="mono small">kept: not conductor's</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </details>
        </section>
      </div>
    </div>
  </div>
</main>
<footer class="small muted"> sessions from the instance's records and <code>claude agents --json</code> · records under ~/example-org/conductor · reads again every 20 s </footer>"
`;

