exports[`the decisions page > has no axe finding, one main, one banner and the navigation 1`] = `
"<header class="top">
  <div class="brand"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="brand-mark" stroke-width="2" stroke-linecap="round" aria-hidden="true">
