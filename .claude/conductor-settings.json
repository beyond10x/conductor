{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "conductor guard record-guard-decision --from-pre-tool-use || exit 2"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "conductor guard record-guard-decision --from-pre-tool-use || exit 2"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "conductor guard record-guard-decision --from-pre-tool-use || exit 2"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "conductor guard record-guard-decision --from-pre-tool-use || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "conductor guard record-guard-decision --from-pre-tool-use || exit 2"
          }
        ]
      }
    ]
  },
  "disableAllHooks": false
}
